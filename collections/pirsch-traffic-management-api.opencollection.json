            "name": "Create or update traffic filter",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pirsch.io/api/v1/filter",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create or update traffic filter"
        },
        {
          "info": {
            "name": "Delete traffic filter",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.pirsch.io/api/v1/filter",
