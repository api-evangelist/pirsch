{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pirsch Access Links Traffic Management API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
