{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pirsch Access Links Tracking API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tracking",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send a page view",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pirsch.io/api/v1/hit",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Track a single page view for a domain"
        },
        {
          "info": {
            "name": "Send multiple page views",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pirsch.io/api/v1/hit/batch",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Track a batch of page views"
        },
        {
          "info": {
            "name": "Send a custom event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pirsch.io/api/v1/event",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Track a single custom event with optional metadata"
        },
        {
          "info": {
            "name": "Send multiple custom events",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pirsch.io/api/v1/event/batch",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Track a batch of custom events"
        },
        {
          "info": {
            "name": "Keep a session alive",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pirsch.io/api/v1/session",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Extend an existing visitor session"
        },
        {
          "info": {
            "name": "Keep multiple sessions alive",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pirsch.io/api/v1/session/batch",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Extend multiple visitor sessions in a single request"
        }
      ]
    }
  ],
  "bundled": true
}